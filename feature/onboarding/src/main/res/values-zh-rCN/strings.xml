    <string name="onb_join_title">选择你的主节点</string>
    <string name="onb_join_body">无论身在何处，你的身份都属于你。主节点是保存你的账户和设备的地方。请扫描节点的二维码，或输入它的地址。</string>
    <string name="onb_join_scan">扫描节点二维码</string>
    <string name="onb_join_scan_title">扫描节点二维码</string>
    <string name="onb_join_address_label">节点地址</string>
    <string name="onb_join_advanced">高级选项</string>
    <string name="onb_join_node_id_label">节点 ID</string>
    <string name="onb_join_node_id_hint">节点使用自签名证书时需要填写。</string>
    <string name="onb_join_check">继续</string>
    <string name="onb_join_skip">暂不</string>
