    <string name="onb_verify_title">检查你的备份</string>
    <string name="onb_verify_body">请根据你保存的副本，输入以下两处位置的字符。这能证明副本是完整的。</string>
    <string name="onb_verify_group">第 %1$d 至 %2$d 个字符</string>
    <string name="onb_verify_failed">不匹配。请检查你的副本，或再看一次密钥。</string>
    <string name="onb_verify_check">检查</string>
    <string name="onb_verify_show_again">再次显示密钥</string>
    <string name="onb_verify_skip">稍后提醒我</string>

    <string name="onb_restore_title">导入你的身份</string>
    <string name="onb_restore_passkey_body">在这部手机上找到了你的通行密钥备份。请用密码管理器中的通行密钥打开它。</string>
    <string name="onb_restore_passkey">用我的通行密钥恢复 %1$s</string>
    <string name="onb_restore_passkey_failed">该通行密钥无法打开备份。请选择为此备份创建的通行密钥，或用其他方式恢复。</string>
    <string name="onb_restore_body">使用你保存的密钥：密钥文件、二维码或文本。</string>
    <string name="onb_restore_paste_label">私钥</string>
