    <string name="onb_welcome_title">Boson Identity</string>
    <string name="onb_welcome_body">你的 Boson 身份是一把密钥，在 Boson 网络中代表你本人。本应用将它保存在这部手机上，由你自己掌控，并用它来批准你的设备、保护你的账户。</string>
    <string name="onb_welcome_create">创建新身份</string>
    <string name="onb_welcome_restore">我已有身份</string>

    <string name="onb_created_title">这是你的新身份</string>
    <string name="onb_created_body">这个图案和 ID 属于你在这部手机上生成的新密钥，其他人都没有。接下来，请保存一份副本。</string>
    <string name="onb_created_continue">备份我的密钥</string>

    <string name="onb_backup_title">备份你的密钥</string>
    <string name="onb_backup_body">如果手机丢失而你又没有这把密钥的副本，任何人（包括我们）都无法找回你的身份。请至少用一种方式保存它，并放在只有你能访问的地方。</string>
    <string name="onb_backup_save_file">保存密钥文件</string>
    <string name="onb_backup_file_saved">密钥文件已保存。</string>
    <string name="onb_backup_show_qr">显示为二维码</string>
    <string name="onb_backup_qr_description">你的私钥二维码</string>
    <string name="onb_backup_show_text">显示为文本</string>
    <string name="onb_backup_copy">复制</string>
    <string name="onb_backup_copied">已复制。剪贴板将在 %1$d 秒后清空。</string>
    <string name="onb_backup_warning">任何拥有这把密钥的人都能以你的身份行事。切勿发送给任何人，也切勿输入到任何网站。</string>
    <string name="onb_backup_continue">我已保存</string>
    <string name="onb_backup_unlock_body">要显示你的密钥，请用屏幕锁确认。</string>
