<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!--
      The identity never leaves through Android backup: allowBackup is off and the data extraction
      rules exclude everything, so neither cloud backup nor device-to-device transfer copies the vault.
      Moving to a new phone goes through the app's own, explicit flows.
    -->
    <application
        android:name=".IdentityApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_label"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.BosonIdentity"
        tools:targetApi="36">

        <!-- singleTask: a return from an account provider comes back to the one running activity. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              Returns from account providers: an App Link, verified against
              https://bosonnetwork.io/.well-known/assetlinks.json, so that Android gives it to this app
              only. The token or grant it carries is in the fragment.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="bosonnetwork.io" android:path="/identity/auth" />
            </intent-filter>
        </activity>
        <!--
          Other apps' requests (AppRequests, docs/app-requests.md): an identity's home node, and
          approving the app as a new device. Any app may ask, by an explicit intent to this package
          started for a result; the user sees which app asks and decides. Nothing secret leaves.
        -->
        <activity
            android:name=".AppRequestActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="io.bosonnetwork.identity.action.GET_HOME_NODE" />
                <action android:name="io.bosonnetwork.identity.action.APPROVE_DEVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
